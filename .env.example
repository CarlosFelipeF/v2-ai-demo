# Copy to .env and fill in. .env is git-ignored. Never paste these values into chat.

# --- Dynatrace (osg4479h sprint tenant) ---
DT_ENV_URL=https://osg4479h.sprint.dynatracelabs.com
DT_APPS_URL=https://osg4479h.sprint.apps.dynatracelabs.com
# Access token, scopes: openTelemetryTrace.ingest, metrics.ingest, logs.ingest
DT_INGEST_TOKEN=
# Platform token (read-only) for scripts/verify.py: storage:spans:read storage:logs:read storage:events:read storage:metrics:read storage:buckets:read
DT_PLATFORM_TOKEN=
# Full <script ...></script> tag from the RUM web frontend (manual injection), one line
DT_RUM_SNIPPET=

# --- Arize AX ---
ARIZE_SPACE_ID=
# Space-scoped API key
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=v2-ai-demo

# --- AWS (Bedrock only in Phase A) ---
AWS_PROFILE=v2-ai-demo-local
AWS_REGION=ap-southeast-2
# Verified with `aws bedrock list-inference-profiles` — see docs/SETUP_CREDENTIALS.md
BEDROCK_MODEL_PRIMARY=apac.amazon.nova-lite-v1:0
BEDROCK_MODEL_FALLBACK=apac.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Local wiring ---
GATEWAY_URL=http://127.0.0.1:4000
# Any random string; shared secret between app and gateway. Generate: openssl rand -hex 24
LITELLM_MASTER_KEY=
APP_URL=http://127.0.0.1:8080
DEPLOYMENT_ENV=local
